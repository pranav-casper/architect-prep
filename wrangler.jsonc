{
  // Static site plus a small progress API, served by Cloudflare Workers. Build first with `node tools/build.js`.
  "name": "architect-prep",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "ccafprep.xyz", "custom_domain": true },
    { "pattern": "www.ccafprep.xyz", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Saved progress, keyed by email. Wrangler creates the namespace on first deploy and fills in its id.
  "kv_namespaces": [
    { "binding": "PROGRESS" }
  ]
}
