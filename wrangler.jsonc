{
  // Static site served by Cloudflare Workers. Build first with `node tools/build.js`.
  "name": "architect-prep",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "ccafprep.xyz", "custom_domain": true },
    { "pattern": "www.ccafprep.xyz", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public"
  }
}
